@inject ReferralService NameService
@{
 var action=ViewContext.RouteData.Values["action"]?.ToString();var portal=ViewData["Portal"]?.ToString()??"Gateway";var ctl=portal=="Admin"?"Admin":"Customer";
 var signed=User.Identity?.IsAuthenticated==true && portal is "Admin" or "Customer" && action!="Login";
 var shadow=portal=="Customer" && User.HasClaim("ShadowAdmin","demo-admin");
 var name=portal switch{"Admin"=>"Admin Portal","Customer"=>"Customer Portal","Onboarding"=>"Registration & Onboarding","Referral"=>"Your referral introduction",_=>"Referral Portal"};
}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · HomeEquity Bank · @name</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/solutions.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/heb-theme.css" asp-append-version="true"/>
</head><body class="portal-@portal.ToLowerInvariant() @(signed?"":"public-page")"><a class="skip" href="#main">Skip to content</a>
<div class="portal-announcement"><strong>@(portal=="Admin"?"HomeEquity Bank · Back office":"A dedicated Customer-to-Customer referral portal.")</strong><span>@(portal=="Admin"?"Customer support, approvals and payment operations.":"A friendly introduction. A rewarding connection.")</span><span class="demo-pill">POC DEMO</span></div>
<header class="referral-masthead"><a class="referral-brand" href="/"><img class="heb-brand-logo" src="/images/brand/homeequity-bank.svg" alt="HomeEquity Bank" width="320" height="54"/><span class="heb-brand-caption">@(portal=="Admin"?"Back-office operations":"Referral & Rewards")</span></a><div class="masthead-right"><span>@name</span>@if(signed){<strong>@User.Identity?.Name</strong>}<a class="button" href="/">Choose a portal</a></div></header>
@if(signed){<nav class="portal-navigation" aria-label="Main navigation"><a class="@(action=="Index"?"active":"")" asp-controller="@ctl" asp-action="Index">Overview</a>@if(portal=="Customer"){<a class="@(action=="Sharing"?"active":"")" asp-controller="Customer" asp-action="Sharing">Refer a Friend</a>}
@if(portal=="Admin"){<a class="@(action=="Customers"?"active":"")" asp-controller="Admin" asp-action="Customers">Customers &amp; shadow</a><a class="@(action=="Enquiries"?"active":"")" asp-controller="Admin" asp-action="Enquiries">Sales follow-up</a>}
@if(portal=="Admin"){<a class="@(action=="Applications"?"active":"")" asp-controller="Admin" asp-action="Applications">Application Approval</a>}<a class="@(action=="Rewards"?"active":"")" asp-controller="@ctl" asp-action="Rewards">@(portal=="Admin"?"Reward approvals":"My Rewards")</a>
@if(portal=="Admin"){<a class="@(action=="Activity"?"active":"")" asp-controller="Admin" asp-action="Activity">Activity log</a>}@if(portal=="Customer"){<a class="@(action=="Messages"?"active":"")" asp-controller="Customer" asp-action="Messages">Messages</a><a class="@(action=="Guide"?"active":"")" asp-controller="Customer" asp-action="Guide">Referral guide</a>}
@if(portal=="Customer"){<a class="@(action=="Enquiries"?"active":"")" asp-controller="Customer" asp-action="Enquiries">My Enquiries</a><a class="@(action=="Heb"?"active":"")" asp-controller="Customer" asp-action="Heb">HomeEquity Bank solutions</a>}
@if(!shadow){<form asp-controller="@ctl" asp-action="Logout" method="post"><button class="text-button">Sign out</button></form>}</nav>}
<div class="app-shell">
@if(portal=="Onboarding"){<div class="onboarding-progress"><span class="@(action=="Register"?"current":"done")">01 <b>Create account</b></span><i>→</i><span class="@(action=="Welcome"?"current":"")">02 <b>Your introduction</b></span><i>→</i><span>03 <b>Customer portal</b></span></div>}
<main id="main"><div class="print-bank-brand"><img src="/images/brand/homeequity-bank-dark.svg" alt="HomeEquity Bank" width="280" height="47"/><span>Referral &amp; Rewards · POC demo</span></div>@if(shadow){<div class="shadow-banner" role="status"><div><strong>Viewing as @User.Identity?.Name</strong><span>Admin shadow session. Actions are attributed to admin.</span></div><form asp-controller="Customer" asp-action="ReturnToAdmin" method="post"><button class="button">Return to Admin →</button></form></div>}
@if(TempData["Success"] is string success){<div class="alert success" role="status">✓ @PersonNames.Bold(success, NameService.Read())</div>}@if(TempData["Error"] is string error){<div class="alert error" role="alert">@PersonNames.Bold(error, NameService.Read())</div>}
@RenderBody()</main><footer><img class="heb-footer-logo" src="/images/brand/homeequity-bank.svg" alt="HomeEquity Bank" width="280" height="47"/><strong>HomeEquity Bank Referral Portal</strong><span>@(portal=="Admin"?"Back-office administration and customer support.":"Designed for Customer-to-Customer introductions.")</span><small>Presentation demo by Mars Team · No real messages or money are sent. Illustrative rewards are not an approved HomeEquity Bank offer.</small><small><strong>Rajni Kaushal</strong> · <strong>Kuldip Solanki</strong> · <strong>Sushmitha Amaran</strong> · <strong>V Karim</strong></small></footer></div>
<script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/solutions.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
