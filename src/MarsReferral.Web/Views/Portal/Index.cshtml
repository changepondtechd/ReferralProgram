@model PortalModel
@{ViewData["Title"]="Overview";var data=Model.Data;var referred=data.Customers.Where(x=>x.ReferrerId!=null && (Model.IsOperations||x.ReferrerId==Model.Actor.CustomerId)).ToArray();var paid=data.Rewards.Where(x=>x.Stage==RewardStage.Paid).Sum(x=>x.Amount);var pending=data.Rewards.Where(x=>x.Stage is RewardStage.Pending or RewardStage.Approved or RewardStage.Failed).Sum(x=>x.Amount);var link=Model.Current==null?"":Url.Action("Index","Referral",new{code=Model.Current.Code});}
<div class="page-heading"><div><span class="eyebrow">@(Model.IsOperations?"PROGRAM OVERVIEW":"YOUR DEDICATED REFERRAL PORTAL")</span><h1><strong>@(Model.IsOperations?"Every introduction matters.":$"Welcome, {Model.Current!.Name.Split(' ')[0]}.")</strong></h1><p>@(Model.IsOperations?"Support the customer journey, from a shared invitation to a confirmed reward.":"Help someone you know explore their next chapter, and share a little thank you.")</p></div>@if(Model.IsOperations || Model.CanShare(Model.Current!)){<a class="button secondary" asp-action="@(Model.IsOperations?"Enquiries":"Sharing")">@(Model.IsOperations?"View sales enquiries":"Refer a Friend") →</a>}</div>
<section class="referral-hero"><div><span class="eyebrow">A FRIENDLY INTRODUCTION. A SHARED REWARD.</span><h2>Good things are<br/>better shared.</h2><p>Introduce a friend to home equity possibilities. After qualifying funding and approval, both of you can enjoy a reward.</p><div class="benefit-pair"><div><span>REFERRING CUSTOMER</span><strong>$50</strong></div><div><span>NEW CUSTOMER</span><strong>$25</strong></div></div>@if(Model.IsOperations || Model.CanShare(Model.Current!)){<a class="button" asp-action="Sharing">Share an invitation →</a>}<small>Illustrative CAD rewards · One reward pair per referred customer</small></div><img src="https://www.homeequitybank.ca/wp-content/uploads/CHIP-Reverse-Mortgage.png" alt="A couple enjoying time together"/></section>
<div class="stats"><article><div><p>Friends referred</p><strong>@referred.Length</strong><small>One code. Many connections.</small></div></article><article><div><p>Funded applications</p><strong>@data.Applications.Count(x=>x.Stage==ApplicationStage.Funded)</strong><small>Funding confirmed in demo</small></div></article><article><div><p>Rewards in progress</p><strong>$@pending.ToString("N2")</strong><small>CAD · Awaiting review or payout</small></div></article><article><div><p>Rewards paid</p><strong>$@paid.ToString("N2")</strong><small>CAD · Simulated payments</small></div></article></div>
@if(!Model.IsOperations){<section class="panel refer-friend" id="refer-a-friend"><div class="section-heading"><div><span class="eyebrow">AVAILABLE RIGHT HERE IN YOUR CLIENT PORTAL</span><h2>Refer a Friend</h2><p>@(Model.CanShare(Model.Current!) ? "Your personal link and QR code are ready to share." : Model.SharingUnavailableReason)</p></div></div>
@if(Model.CanShare(Model.Current!)){
<div class="referral-share-grid"><div class="referral-link-panel">
<label for="personal-referral-link">Your referral link</label><div class="input-action"><input id="personal-referral-link" readonly data-absolute-input="@link" value="@link"/><button class="button" type="button" data-copy-url="@link">Copy link</button></div><p>Referral code: <strong>@Model.Current.Code</strong></p><div class="actions"><a class="button social-share-button" asp-action="Sharing"><span>Share on</span><span class="share-platform"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="#087f45" d="M12 1a11 11 0 0 0-9.5 16.5L1 23l5.7-1.5A11 11 0 1 0 12 1Z"/><path fill="none" stroke="#fff" stroke-width="1.3" d="M12 3.4a8.6 8.6 0 0 0-7.4 13l-1 3.9 4-1A8.6 8.6 0 1 0 12 3.4Z"/><path fill="#fff" d="M8.2 6.8c-.3 0-.7.1-.9.4-.3.3-1 1-1 2.3s1 2.6 1.2 2.8c.1.2 2 3.2 5 4.3 2.4.9 2.9.7 3.4.7.5-.1 1.6-.7 1.8-1.3.2-.7.2-1.2.1-1.3-.1-.1-.3-.2-.6-.4l-2-1c-.3-.1-.5-.1-.7.2l-.9 1c-.1.2-.3.2-.6.1-1.8-.8-3-2.1-3.8-3.5-.1-.3 0-.4.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.5L9.2 7c-.2-.4-.4-.3-1-.2Z"/></svg><span>WhatsApp</span></span><span aria-hidden="true">/</span><span class="share-platform"><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect width="24" height="24" rx="3" fill="#0a66c2"/><circle cx="5.6" cy="6" r="1.7" fill="#fff"/><path fill="#fff" d="M4 9h3.2v11H4zm5.5 0h3.1v1.5h.1c.4-.8 1.5-1.8 3.1-1.8 3.3 0 3.9 2.1 3.9 4.9V20h-3.2v-5.7c0-1.4 0-3.1-1.9-3.1s-2.1 1.5-2.1 3V20H9.5Z"/></svg><span>LinkedIn</span></span></a><button class="button secondary" type="button" data-dialog="refer-dialog">Refer someone directly</button></div>
</div><partial name="_ReferralQr" model="Model" /></div>
@if(ReferralSocialPost.Create(Model, Url) is { } socialPost){<partial name="_ReferralSocialPost" model="socialPost" />}
<partial name="_ReferSomeone" model="Model" />
}
@if(Model.Current!.ReferrerId == null){<details><summary>Have a friend's referral code?</summary><form asp-action="Attach" method="post"><label for="attach-code">Friend's referral code</label><div class="input-action"><input id="attach-code" name="code" required minlength="6" maxlength="16"/><button class="button">Attach code</button></div></form></details>}
</section>}
@if(Model.IsOperations){
<div class="content-grid"><section class="panel"><h2>Recent connections</h2>@foreach(var person in referred.Reverse().Take(5)){<div class="person-row"><span class="avatar">@Model.Initials(person.Name)</span><div><strong>@person.Name</strong><small>Connected through a referral</small></div></div>}@if(referred.Length==0){<p>Your circle starts with a friendly introduction.</p>}</section><section class="panel accent-panel"><span class="eyebrow">KEEP THE JOURNEY MOVING</span><h2>Your next steps</h2><p>@data.Enquiries.Count(x=>x.Status=="New") new enquiries and @data.Rewards.Count(x=>x.Stage==RewardStage.Pending) rewards awaiting review.</p><a class="button secondary" asp-action="Rewards">Review rewards →</a></section></div>
}
<section class="journey-strip"><div><span>01</span><strong>Share your link</strong><small>A personal invitation</small></div><div><span>02</span><strong>Your friend enquires</strong><small>Salesperson follow-up</small></div><div><span>03</span><strong>Funding confirmed</strong><small>Rewards enter review</small></div><div><span>04</span><strong>Enjoy a shared reward</strong><small>After approval and payout</small></div></section>
