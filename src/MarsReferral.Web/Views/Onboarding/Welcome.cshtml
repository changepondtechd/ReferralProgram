@model Customer
@{ViewData["Title"]="Your introduction";}
<div class="onboarding-welcome"><section><span class="eyebrow">STEP 02 / WELCOME ABOARD</span><h1>You're almost<br/><em>in the circle, <strong>@Model.Name.Split(' ')[0]</strong>.</em></h1><p class="muted">Your account has been created. Take a moment to review how referrals work before opening your customer workspace.</p><div class="onboarding-profile"><span class="avatar">@Model.Name[0]</span><div><strong>@Model.Name</strong><small>@Model.Email</small></div><span class="badge neutral">@(Model.OnboardingComplete?"Complete":"Onboarding")</span></div><div class="hint"><strong>@(Model.ReferrerId==null?"No referral attached yet":"Your friend's code is attached")</strong><p>@(Model.ReferrerId==null?"You can attach a friend's code once from the customer overview after onboarding.":"Your referral is saved on your profile. It carries across your applications and cannot be replaced.")</p></div></section>
<section class="panel"><span class="eyebrow">A QUICK INTRODUCTION</span><h2>Three things to know.</h2><div class="admin-feature"><span>01</span><div><h3>Your profile keeps the code</h3><p>One code per referred customer. Your own sharing code can invite many friends.</p></div></div><div class="admin-feature"><span>02</span><div><h3>Funding starts reward review</h3><p>The demo uses $25 welcome and $50 referrer rewards, once per referred customer after qualifying funding.</p></div></div><div class="admin-feature"><span>03</span><div><h3>Nothing is paid automatically</h3><p>Admin approval and a confirmed simulated payout are required. No real money or external message is sent.</p></div></div>
@if(!Model.OnboardingComplete){<form asp-action="Complete" method="post"><label class="check-label"><input type="checkbox" name="understood" value="true" required/>I understand the demo referral rules above.</label><button class="button full">Finish onboarding & open my portal →</button></form>}else{<a class="button full" href="/customer/login">Go to customer sign-in →</a>}</section></div>
<partial name="_SolutionsSlider" />
