@model PortalModel
@{ViewData["Title"]="Customers";var list=Model.Data.Customers.Where(x=>string.IsNullOrEmpty(Model.Query) || $"{x.Name} {x.Email} {x.Code}".Contains(Model.Query,StringComparison.OrdinalIgnoreCase)).ToArray();}
<div class="page-heading"><div><div class="eyebrow">ADMIN / PEOPLE</div><h1>The people in your circle.</h1><p class="muted">One permanent referral relationship per profile. Unlimited introductions per sharing code.</p></div><a class="button" asp-controller="Onboarding" asp-action="Register">+ New customer</a></div>
<div class="panel"><div class="section-heading"><h2>Customer directory <span class="count">@list.Length</span></h2><form class="search" method="get"><label class="sr-only" for="q">Search customers</label><input id="q" name="q" value="@Model.Query" placeholder="Search name, email or code"/><button class="button small secondary">Search</button></form></div>
<div class="table-scroll"><table><thead><tr><th>Customer</th><th>Sharing code</th><th>Attached referral</th><th>Connections</th><th>Manage</th></tr></thead><tbody>
@foreach(var c in list){<tr><td><div class="person-cell"><span class="avatar color-@(c.Id % 4)">@Model.Initials(c.Name)</span><div><strong>@c.Name</strong><small>@c.Email</small><small>@(c.OnboardingComplete?"Onboarding complete":"Onboarding pending")</small></div></div></td><td><code>@c.Code</code><small><span class="badge @(c.CodeActive ? "good" : "warn")">@(c.CodeActive ? "Active" : "Paused")</span></small></td><td>@if(c.ReferrerId is int owner){<strong>@Model.Name(owner)</strong><small>Locked to profile</small>}else{<span class="muted">No code attached</span>}</td><td><strong>@Model.Data.Customers.Count(x=>x.ReferrerId == c.Id)</strong> friends</td><td><form asp-action="Shadow" method="post"><input type="hidden" name="customerId" value="@c.Id"/><button class="button small secondary">Shadow customer ↗</button></form><details><summary>Manage referral ↗</summary><div class="row-actions">@if(c.ReferrerId == null){<form asp-action="Attach" method="post"><input type="hidden" name="customerId" value="@c.Id"/><label for="code-@c.Id">Attach friend's code</label><input id="code-@c.Id" name="code" required minlength="6" maxlength="16" placeholder="MARS000001"/><button class="button small">Attach once</button></form>}else{<p class="field-help">Already used a referral code. Replacement is blocked.</p>}<form asp-action="ToggleCode" method="post"><input type="hidden" name="customerId" value="@c.Id"/><button class="button small secondary">@(c.CodeActive ? "Pause sharing code" : "Reactivate sharing code")</button></form></div></details></td></tr>}
</tbody></table></div>@if(list.Length==0){<div class="empty"><h3>No customers match your search.</h3><a asp-action="Customers">Clear search</a></div>}</div>