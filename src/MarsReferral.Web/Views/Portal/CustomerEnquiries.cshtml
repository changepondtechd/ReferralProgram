@model PortalModel
@{ViewData["Title"]="My enquiries";var own=Model.Data.Enquiries.Where(x=>string.Equals(x.Email,Model.Current!.Email,StringComparison.OrdinalIgnoreCase)).ToArray();var referred=Model.Data.Enquiries.Where(x=>x.ReferrerId==Model.Actor.CustomerId).ToArray();}
<div class="page-heading"><div><span class="eyebrow">YOUR REFERRALS / YOUR ENQUIRIES</span><h1>Follow every introduction.</h1><p>Track enquiries made through your referral link and enquiries you submitted yourself.</p></div><a class="button secondary" asp-action="Sharing">Refer a Friend →</a></div>
<div class="stats"><article><div><p>People you referred</p><strong>@referred.Length</strong><small>Enquiries through your link</small></div></article><article><div><p>Your own enquiries</p><strong>@own.Length</strong><small>Matched to your account email</small></div></article><article><div><p>Awaiting follow-up</p><strong>@Model.Data.Enquiries.Count(x=>x.Status=="New")</strong><small>Assigned to the demo salesperson</small></div></article><article><div><p>Contacted</p><strong>@Model.Data.Enquiries.Count(x=>x.Status=="Contacted")</strong><small>Follow-up recorded in the demo</small></div></article></div>
@foreach(var group in new[]{(Title:"People I referred",Items:referred,Own:false),(Title:"My own enquiries",Items:own,Own:true)}){
<section class="panel" style="margin-top:24px"><h2>@group.Title</h2>
@if(group.Items.Length==0){<p class="muted">@(group.Own?"No enquiries are linked to your account email yet. Enquiries submitted using this email appear here automatically.":"No one has submitted an enquiry through your link yet. Share your referral link to get started.")</p>}
else{<div class="table-scroll"><table><thead><tr><th>Enquiry</th>@if(group.Own){<th>Your details</th><th>Referred by</th>}<th>Salesperson</th><th>Status</th><th>Submitted</th></tr></thead><tbody>
@foreach(var e in group.Items.OrderByDescending(x=>x.CreatedAt)){<tr><td><strong>@e.Name</strong><small>ENQ-@e.Id[..8].ToUpperInvariant()</small>@if(group.Own){<small>@e.Interest</small>}</td>@if(group.Own){<td>@e.Email<small>@e.Phone</small></td><td><strong>@Model.Name(e.ReferrerId)</strong></td>}<td><strong>@e.Salesperson</strong><small>Demo salesperson</small></td><td><span class="badge @(e.Status=="New"?"pending":"good")">@(e.Status=="New"?"Awaiting follow-up":"Contacted")</span></td><td>@e.CreatedAt.ToString("dd MMM yyyy")</td></tr>}
</tbody></table></div>}
</section>}
<p class="field-help">Status updates appear here after admin records a follow-up. A referrer sees progress, while contact details and the enquiry topic are visible only to the enquirer and admin. Enquiries alone do not earn rewards; qualifying funding and approval are still required.</p>
