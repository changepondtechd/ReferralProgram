@model RegisterInput
@{ViewData["Title"]="Join the circle";}
<div class="onboarding-registration"><section class="panel narrow"><div class="eyebrow">STEP 01 / CREATE YOUR ACCOUNT</div><h1>Join the circle.</h1><p class="muted">Create a demo profile. Have a friend's code? Add it now, or attach it later from your overview.</p><form asp-action="Register" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Name">Full name</label><input asp-for="Name" maxlength="80" minlength="2" required placeholder="Your full name"/><label asp-for="Email">Email address</label><input asp-for="Email" type="email" maxlength="160" required placeholder="you@example.com"/><label asp-for="ReferralCode">Friend's referral code <span class="muted">(optional)</span></label><input asp-for="ReferralCode" maxlength="16" placeholder="For example MARS000001"/><p class="field-help">One code attaches to your profile permanently. The demo welcome benefit is $25 CAD after qualifying funding and approval.</p><button class="button full">Create account & continue →</button></form><a class="back-link" asp-controller="Customer" asp-action="Login">Already registered? Customer sign-in</a></section>
<partial name="_SolutionsSlider" /></div>
