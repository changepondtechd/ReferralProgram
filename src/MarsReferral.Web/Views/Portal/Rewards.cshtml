@model PortalModel
@{ViewData["Title"]="Rewards";var list=Model.Data.Rewards.Where(x=>string.IsNullOrEmpty(Model.Status)||x.Stage.ToString()==Model.Status).OrderByDescending(x=>x.Id).ToArray();}
<div class="page-heading"><div><div class="eyebrow">@(Model.IsOperations?"BACK OFFICE / REWARDS":"GOOD CONNECTIONS PAY IT FORWARD")</div><h1>@(Model.IsOperations?"Reward approvals and payments":"A little thank you. Times two.")</h1><p class="muted">$25 welcome reward for the friend. $50 referral reward for the person who introduced them.</p></div><span class="policy-tag">DEMO POLICY / ONCE PER CUSTOMER</span></div>
<div class="tabs"><a class="@(Model.Status==""?"selected":"")" asp-action="Rewards">All rewards</a>@foreach(var stage in Enum.GetNames<RewardStage>()){<a class="@(Model.Status==stage?"selected":"")" asp-action="Rewards" asp-route-status="@stage">@stage</a>}</div>
<section class="panel"><div class="section-heading"><h2>@(Model.IsOperations?"Reward workspace":"Your rewards") <span class="count">@list.Length</span></h2><span class="muted">All rewards in Canadian dollars (CAD)</span></div><div class="table-scroll"><table><thead><tr><th>Reward / Recipient</th><th>Connection</th><th>Benefit</th><th>Status</th><th>@(Model.IsOperations?"Action":"Payment details")</th></tr></thead><tbody>
@foreach(var r in list){<tr><td><strong>@Model.Name(r.BeneficiaryId)</strong><small>#@r.Id · @r.Kind</small></td><td><strong>@Model.Name(r.ReferredId)</strong><small>Application #@r.ApplicationId</small></td><td><strong class="reward-value">$@r.Amount.ToString("N2")</strong><small>CAD</small></td><td><span class="badge @r.Stage.ToString().ToLowerInvariant()">@r.Stage</span>@if(!string.IsNullOrEmpty(r.Note)){<small class="note">@PersonNames.Bold(r.Note,Model.Data)</small>}</td><td>
@if(Model.IsOperations && r.Stage==RewardStage.Pending){<form asp-action="Review" method="post"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="approve" value="true"/><button class="button small">Approve reward</button></form><details><summary class="danger">Reject with reason</summary><form asp-action="Review" method="post"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="approve" value="false"/><label for="reason-@r.Id">Reason</label><input id="reason-@r.Id" name="reason" required minlength="5" maxlength="300"/><button class="button small secondary">Confirm rejection</button></form></details>}
else if(Model.IsOperations && r.Stage is RewardStage.Approved or RewardStage.Failed){<button type="button" class="button small" data-dialog="payout-@r.Id">@(r.Stage==RewardStage.Failed?"Retry payout":"Simulate payout")</button>}
else{<small>@(string.IsNullOrEmpty(r.Reference)?"No payment recorded":r.Reference)</small>}
</td></tr>}</tbody></table></div>@if(list.Length==0){<div class="empty"><span>◇</span><h3>No rewards in this stage.</h3><p>Qualifying funding starts the reward journey. Attachment alone does not create a payout.</p></div>}</section>
<div class="hint"><strong>Only a confirmed payment increases the paid balance.</strong><p>A failed payout remains unpaid and can be retried. Rejected rewards stay in the audit history. Duplicate funding and payment actions are blocked.</p></div>
@if(ViewData["PayoutInput"] is PayInput failed && !Model.Data.Rewards.Any(x=>x.Id==failed.Id && x.Stage is RewardStage.Approved or RewardStage.Failed)){<div asp-validation-summary="All" class="validation" role="alert"></div>}
@if(Model.IsOperations){foreach(var r in Model.Data.Rewards.Where(x=>x.Stage is RewardStage.Approved or RewardStage.Failed)){var failedInput=ViewData["PayoutInput"] as PayInput;var retry=failedInput?.Id==r.Id;
<dialog id="payout-@r.Id" aria-labelledby="payout-title-@r.Id" data-open-on-load="@(retry?"true":"false")"><div class="dialog-heading"><h2 id="payout-title-@r.Id">Simulate reward payment</h2><button type="button" class="icon-button" data-close aria-label="Close payment dialog">×</button></div><p><strong>@Model.Name(r.BeneficiaryId) · $@r.Amount.ToString("N2") CAD</strong></p><p>Reward #@r.Id · @r.Kind. No real money is transferred.</p>
<form asp-action="Pay" method="post">@if(retry){<div asp-validation-summary="All" class="validation" role="alert"></div>}<input type="hidden" name="Id" value="@r.Id"/>
<label for="pay-reference-@r.Id">Payment reference</label><input id="pay-reference-@r.Id" name="Reference" required minlength="4" maxlength="40" pattern="[A-Za-z0-9\-]{4,40}" value="@(retry?failedInput!.Reference:"PAY-"+Guid.NewGuid().ToString("N")[..12].ToUpperInvariant())"/><small>4–40 letters, numbers or hyphens. Each paid reward needs a unique reference.</small>
<label for="pay-result-@r.Id">Simulated outcome</label><select id="pay-result-@r.Id" name="Successful" required><option value="true" selected="@(!retry || failedInput!.Successful!=false)">Confirmed success</option><option value="false" selected="@(retry && failedInput!.Successful==false)">Failed — allow retry</option></select><div class="actions"><button class="button" type="submit">Record simulated payout</button><button class="button secondary" type="button" data-close>Cancel</button></div></form></dialog>}}
