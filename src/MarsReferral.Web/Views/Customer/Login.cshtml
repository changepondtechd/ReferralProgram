@model Customer[]
@{ViewData["Title"]="Customer sign-in";}
<div class="login-grid"><section class="login-story"><div class="eyebrow">HOMEEQUITY BANK / CUSTOMER PORTAL</div><h1>Your connections.<br/><em>Your rewards.</em></h1><p>A space just for your referral journey. Share your code, follow your applications and track each reward.</p><div class="orbit-art"><div class="orbit-ring"></div><div class="orbit-ring small"></div><div class="orbit-center">m°</div><span class="orb orb-a">LT</span><span class="orb orb-b">OM</span><span class="orb orb-c">+$25</span><span class="orb orb-d">✦</span></div></section>
<section class="panel login-form"><span class="eyebrow">CUSTOMER ACCESS</span><h2>Back to your circle.</h2><p class="muted">Choose a sample customer to explore their workspace. Each customer sees their own applications, rewards and messages.</p><form asp-action="Enter" method="post"><label for="customerId">Customer account</label><select name="customerId" id="customerId">@foreach(var c in Model){<option value="@c.Id">@c.Name — @(!c.OnboardingComplete?"Finish onboarding":c.ReferrerId==null?"No attached code":"Referral attached")</option>}</select><button class="button full">Enter Customer Portal →</button></form><div class="divider">FIRST TIME HERE?</div><a class="button secondary full" href="/join">Registration & Onboarding ↗</a><div class="hint"><strong>Try a different story</strong><p><strong>Liam</strong> shares with many friends. <strong>Ethan</strong> has no code yet. <strong>Olivia</strong> has an attached code. <strong>Emma</strong> has pending rewards. <strong>Noah</strong> has paid rewards.</p></div><a class="back-link" href="/">← Choose another portal</a></section></div>