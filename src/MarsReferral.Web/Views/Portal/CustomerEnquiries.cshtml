@model PortalModel
@{ViewData["Title"]="My enquiries";var referred=Model.Data.Enquiries.Where(x=>x.ReferrerId==Model.Actor.CustomerId).ToArray();}
<div class="page-heading"><div><span class="eyebrow">YOUR REFERRALS</span><h1>Follow every introduction.</h1><p>Track enquiries made through your referral link.</p></div><a class="button secondary" asp-action="Sharing">Refer a Friend →</a></div>
<div class="stats"><article><div><p>People you referred</p><strong>@referred.Length</strong><small>Enquiries through your link</small></div></article><article><div><p>Awaiting follow-up</p><strong>@referred.Count(x=>x.Status=="New")</strong><small>Assigned to the demo salesperson</small></div></article><article><div><p>Contacted</p><strong>@referred.Count(x=>x.Status=="Contacted")</strong><small>Follow-up recorded in the demo</small></div></article></div>
<section class="panel" style="margin-top:24px"><h2>People I referred</h2>
@if(referred.Length==0){<p class="muted">No one has submitted an enquiry through your link yet. Share your referral link to get started.</p>}
else{<div class="table-scroll"><table><thead><tr><th>Enquiry</th><th>Salesperson</th><th>Status</th><th>Submitted</th></tr></thead><tbody>
@foreach(var e in referred.OrderByDescending(x=>x.CreatedAt)){<tr><td><strong>@e.Name</strong><small>ENQ-@e.Id[..8].ToUpperInvariant()</small></td><td><strong>@e.Salesperson</strong><small>Demo salesperson</small></td><td><span class="badge @(e.Status=="New"?"pending":"good")">@(e.Status=="New"?"Awaiting follow-up":"Contacted")</span></td><td>@e.CreatedAt.ToString("dd MMM yyyy")</td></tr>}
</tbody></table></div>}
</section>
<p class="field-help">Status updates appear here after admin records a follow-up. Enquiries alone do not earn rewards; qualifying funding and approval are still required.</p>
