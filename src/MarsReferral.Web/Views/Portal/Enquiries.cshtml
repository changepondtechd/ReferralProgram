@model PortalModel
@{ViewData["Title"]="Sales follow-up";}
<div class="page-heading"><div><span class="eyebrow">REFERRAL ENQUIRIES / DEMO SALES TEAM</span><h1>Enquiry management.</h1><p>Every submitted enquiry is assigned to <strong>Sarah Mitchell</strong>, the demo salesperson.</p></div><span class="badge neutral">@Model.Data.Enquiries.Length enquiries</span></div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Enquiry</th><th>Contact details</th><th>Referred by</th><th>Assigned to</th><th>Status / next step</th></tr></thead><tbody>@foreach(var e in Model.Data.Enquiries.OrderByDescending(x=>x.CreatedAt)){<tr><td><strong>@e.Name</strong><small>ENQ-@e.Id[..8].ToUpperInvariant()</small><small>@e.Interest</small></td><td>@e.Email<small>@e.Phone</small></td><td><strong>@Model.Name(e.ReferrerId)</strong></td><td><strong>@e.Salesperson</strong><small>Demo salesperson</small></td><td><span class="badge good">@e.Status</span>@if(e.Status=="New"){<form asp-action="Contacted" method="post"><input type="hidden" name="id" value="@e.Id"/><button class="button small secondary">Simulate follow-up</button></form>}</td></tr>}</tbody></table></div>@if(Model.Data.Enquiries.Length==0){<div class="empty"><h2>No enquiries yet.</h2><p>Submitted customer enquiries will appear here for assignment and follow-up.</p></div>}</section><p class="field-help">Contact details are shown to admin only. Follow-up actions are simulated; no external messages or calls are made.</p>
