@model PortalModel
@{ var input = ViewData["ReferInput"] as ReferInput ?? new ReferInput(); var shared = TempData["DirectReferralShared"] is true; var successTitle = "Thanks for referring your friend!"; }
<dialog id="refer-dialog" class="refer-dialog" aria-labelledby="refer-title" data-open-on-load="@(shared || ViewData["OpenReferral"] is true ? "true" : "false")" data-referral-complete="@(shared ? "true" : "false")">
 <div class="dialog-heading"><div><span class="eyebrow">ONE INTRODUCTION. TWO BENEFITS.</span><h2 id="refer-title" data-success-title="@successTitle">@(shared ? successTitle : "Refer someone")</h2></div><button type="button" class="icon-button" data-close aria-label="Close referral dialog">×</button></div>
 <div id="refer-form-content" hidden="@shared">
 <p>Create an invitation for your friend. They can open the invitation link and submit their own details and consent to create their account. No account is created when you refer them or when they open the link.</p>
 <div class="referral-code-note">Your referral code <strong>@Model.Current!.Code</strong> will be attached when your friend registers through the link.</div>
 <form asp-controller="Customer" asp-action="Refer" method="post" id="direct-referral-form">
  <div asp-validation-summary="All" class="validation" role="alert" id="refer-errors" tabindex="-1"></div>
  <label for="refer-name">Friend's full name</label><input id="refer-name" name="Name" value="@input.Name" required minlength="2" maxlength="80" autocomplete="off" placeholder="e.g. Alex Morgan"/>
  <label for="refer-email">Email address</label><input id="refer-email" name="Email" type="email" value="@input.Email" required maxlength="160" autocomplete="off" placeholder="alex@example.com"/>
  <label for="refer-phone">Phone number</label><input id="refer-phone" name="Phone" type="tel" value="@input.Phone" required maxlength="30" autocomplete="off" aria-describedby="refer-phone-help" placeholder="e.g. +1 416 555 0123"/>
  <p id="refer-phone-help" class="field-help">10–15 digits. Include the country code where needed.</p>
  <p class="field-help">Use details your friend has agreed to share. This demo does not send an email or SMS. Rewards become eligible only after funding and approval.</p>
  <div class="actions"><button class="button" type="submit">Send Invitation</button><button class="button secondary" type="button" data-close>Cancel</button></div>
 </form>
 </div>
 <div id="refer-confirmation" hidden="@(!shared)" role="status">
  <p>Your invitation has been saved. Open <a asp-controller="Customer" asp-action="Messages">Messages</a> to share the invitation link with your friend. They can create their account by submitting their own details and consent. No account has been created and no email or SMS has been sent.</p>
  <div class="actions"><button class="button" type="button" data-close autofocus="@shared">OK</button></div>
 </div>
</dialog>
