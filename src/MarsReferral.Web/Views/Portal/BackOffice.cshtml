@model PortalModel
@{ViewData["Title"]="Back-office overview";var data=Model.Data;}
<div class="page-heading"><div><span class="eyebrow">BACK OFFICE / OPERATIONS</span><h1>Operations overview</h1><p>Manage customer records, follow up enquiries, approve applications and process reward payments.</p></div><a class="button" asp-action="Enquiries">Open enquiry queue →</a></div>
<div class="stats"><article><div><p>New enquiries</p><strong>@data.Enquiries.Count(x=>x.Status=="New")</strong><small>Awaiting salesperson follow-up</small></div></article><article><div><p>Applications to review</p><strong>@data.Applications.Count(x=>x.Stage==ApplicationStage.Submitted)</strong><small>Pending amount approval</small></div></article><article><div><p>Rewards to approve</p><strong>@data.Rewards.Count(x=>x.Stage==RewardStage.Pending)</strong><small>Review qualifying rewards</small></div></article><article><div><p>Failed payments</p><strong>@data.Rewards.Count(x=>x.Stage==RewardStage.Failed)</strong><small>Review and retry payouts</small></div></article></div>
<div class="content-grid" style="margin-top:24px"><section class="panel"><h2>Work queues</h2><div class="actions"><a class="button secondary" asp-action="Customers">Customer records &amp; shadow</a><a class="button secondary" asp-action="Applications">Application approvals</a><a class="button secondary" asp-action="Rewards">Reward approvals &amp; payments</a><a class="button secondary" asp-action="Activity">Audit trail</a></div></section><section class="panel"><h2>Latest enquiries</h2>@foreach(var e in data.Enquiries.OrderByDescending(x=>x.CreatedAt).Take(5)){<div class="person-row"><div><strong>@e.Name</strong><small>@e.Status · Assigned to <strong>@e.Salesperson</strong></small></div></div>}@if(data.Enquiries.Length==0){<p>No enquiries awaiting review.</p>}<a asp-action="Enquiries">View all enquiries →</a></section></div>
<section class="panel" style="margin-top:24px"><h2>Recent operational activity</h2><div class="table-scroll"><table><thead><tr><th>Date</th><th>Customer</th><th>Action</th><th>Details</th></tr></thead><tbody>@foreach(var a in data.Audit.OrderByDescending(x=>x.At).Take(5)){<tr><td>@a.At.ToString("dd MMM yyyy")</td><td><strong>@(a.CustomerId is int id?Model.Name(id):"—")</strong></td><td>@a.Action</td><td>@PersonNames.Bold(a.Detail,data)</td></tr>}</tbody></table></div></section>
